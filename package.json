{
  "name": "@retail/admin-engine",
  "version": "0.2.0",
  "private": true,
  "description": "Shared retail admin engine (blog + product) for The Nutty Squirrel and The Witty Badger. Brand-agnostic; the host injects a Supabase client per brand.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./blog": { "types": "./dist/blog.d.ts", "default": "./dist/blog.js" },
    "./brands": { "types": "./dist/brands.d.ts", "default": "./dist/brands.js" }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "license": "UNLICENSED"
}
